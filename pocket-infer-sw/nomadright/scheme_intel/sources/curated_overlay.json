{
  "_about": "Hand-curated presentation layer for the scheme-intelligence knowledge base. It adds NO new scheme facts: every voice_summary restates facts that exist in the cited source fields (summary_basis). Spoken names/aliases/domains/target_occupations are classification metadata used for routing, not claims made to users. Unknown values stay null.",
  "_sources": {
    "canonical": "sources/gov_scheme_qa/data (extracted from the official compilation 'scheme 2.pdf')",
    "legacy": "../*.json - the existing NomadRight scheme files (myscheme.gov.in, nha.gov.in, eshram.gov.in, labour.gov.in, nrega.nic.in ...), read-only",
    "seed": "../<code>.json compact seed records - only their official URLs are used"
  },
  "domain_primary": {
    "RATION": ["SCH_ONORC"],
    "HEALTH": ["SCH_PMJAY"],
    "MIGRANT": ["SCH_ONORC", "SCH_ESHRAM", "SCH_BOCW", "SCH_PMJAY"]
  },
  "unverified_schemes": {
    "matru vandana": "Pradhan Mantri Matru Vandana Yojana",
    "pmmvy": "Pradhan Mantri Matru Vandana Yojana",
    "janani suraksha": "Janani Suraksha Yojana",
    "pmay urban": "PM Awas Yojana Urban",
    "pmay-u": "PM Awas Yojana Urban",
    "awas yojana urban": "PM Awas Yojana Urban",
    "udid": "the UDID disability card",
    "national scholarship": "the National Scholarship Portal",
    "scholarship portal": "the National Scholarship Portal",
    "kisan credit card": "the Kisan Credit Card",
    "stand up india": "Stand-Up India",
    "pm poshan": "PM POSHAN",
    "mid day meal": "the mid-day meal scheme",
    "ladli behna": "Ladli Behna Yojana"
  },
  "verify_fields": [
    "citizenship", "aadhaar", "has_bank_account", "aadhaar_seeded_ration", "nfsa_beneficiary",
    "vending_since_march_2020", "cov_or_id_card", "in_survey_list", "lor_from_ulb", "willing_manual_work",
    "insurable_interest", "crop_notified", "land_in_family_name", "roof_type", "ignoaps_member",
    "in_awasplus_list", "lpg_connection", "has_electricity_connection", "in_secc_2011"
  ],
  "extra_rules": [
    {
      "rule_id": "RULE_ESHRAM_ELIG", "scheme_id": "SCH_ESHRAM", "rule_type": "QUALIFICATION",
      "description": "Eligible to register on e-Shram",
      "source": "eshram_osh.json eligibility (eshram.gov.in)",
      "conditions": [
        {"field": "age", "op": ">=", "value": 16, "desc": "Aged 16 or above", "source": "eshram.gov.in"},
        {"field": "age", "op": "<=", "value": 59, "desc": "Aged 59 or below", "source": "eshram.gov.in"},
        {"field": "is_unorganised_worker", "op": "==", "value": true, "desc": "Works in the unorganised sector", "source": "eshram.gov.in"},
        {"field": "aadhaar", "op": "==", "value": true, "desc": "Has Aadhaar with a linked mobile number for OTP", "source": "eshram.gov.in"}
      ]
    },
    {
      "rule_id": "RULE_ESHRAM_EXCL", "scheme_id": "SCH_ESHRAM", "rule_type": "EXCLUSION",
      "description": "EPFO/ESIC members cannot register on e-Shram",
      "source": "eshram_osh.json eligibility/exceptions (eshram.gov.in)",
      "conditions": [
        {"field": "epfo_esic_member", "op": "==", "value": true, "desc": "is covered by PF or ESI", "source": "eshram.gov.in"}
      ]
    },
    {
      "rule_id": "RULE_PMJAY_ELIG", "scheme_id": "SCH_PMJAY", "rule_type": "QUALIFICATION",
      "description": "Eligible for AB PM-JAY: SECC 2011 family, or any citizen aged 70+",
      "source": "pmjay.json eligibility (nha.gov.in, pmjay.gov.in, india.gov.in)",
      "conditions": [
        {"op": "OR", "desc": "Family is in the SECC 2011 list, or you are 70 or older", "items": [
          {"field": "in_secc_2011", "op": "==", "value": true, "desc": "Family is listed in the SECC 2011 data", "source": "nha.gov.in"},
          {"field": "age", "op": ">=", "value": 70, "desc": "Aged 70 or above", "source": "india.gov.in, pib.gov.in"}
        ]}
      ]
    },
    {
      "rule_id": "RULE_PMJAY_EXCL", "scheme_id": "SCH_PMJAY", "rule_type": "EXCLUSION",
      "description": "SECC 2011 exclusion criteria (not applied to the 70+ category)",
      "source": "pmjay.json exceptions (SECC 2011 exclusion criteria)",
      "unless": {"field": "age", "op": ">=", "value": 70},
      "conditions": [
        {"field": "income_tax_payer", "op": "==", "value": true, "desc": "household pays income tax", "source": "SECC 2011"},
        {"field": "govt_employee_or_family", "op": "==", "value": true, "desc": "a household member is a government employee", "source": "SECC 2011"}
      ]
    },
    {
      "rule_id": "RULE_ONORC_NFSA_CATEGORY", "scheme_id": "SCH_ONORC", "rule_type": "QUALIFICATION",
      "description": "NFSA beneficiary (AAY or PHH category)",
      "source": "pds.json eligibility[2] (nfsa.gov.in, dfpd.gov.in)",
      "conditions": [
        {"field": "nfsa_beneficiary", "op": "==", "value": true, "desc": "Card is an NFSA card (Antyodaya or Priority Household)", "source": "nfsa.gov.in"}
      ]
    },
    {
      "rule_id": "RULE_BOCW_EXCL", "scheme_id": "SCH_BOCW", "rule_type": "EXCLUSION",
      "description": "Workers covered by ESIC / other organised-sector social security are not eligible",
      "source": "bocw.json eligibility[4], exceptions[0] (BOCW Act 1996)",
      "conditions": [
        {"field": "epfo_esic_member", "op": "==", "value": true, "desc": "is covered by ESI or PF", "source": "BOCW Act 1996"}
      ]
    }
  ],
  "rule_patches": {
    "_about": "group_kind=verify: the either/or list condition (SECC 2011 housing data / Awaas+ list) can only be confirmed officially, so it never makes a person ELIGIBLE on their own statement.",
    "RULE_PMAYG_ELIG": {"group_kind": "verify"},
    "RULE_BOCW_ELIG": {"soft_if": {"field": "construction_days_12m", "when_occupation_in": ["CONSTRUCTION_WORKER"]}},
    "RULE_SSY_ELIG": {"replace_fields": {"demographic.gender+demographic.age": "girl_child_under_10"}}
  },

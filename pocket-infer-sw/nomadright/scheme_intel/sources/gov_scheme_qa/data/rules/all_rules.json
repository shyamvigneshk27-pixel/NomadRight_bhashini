    "operator": "AND",
    "conditions": [
      {
        "field": "demographic.citizenship",
        "operator": "==",
        "value": "INDIAN",
        "description": "Must be an Indian Citizen",
        "citation": "Page 3, PMSYM Eligibility"
      },
      {
